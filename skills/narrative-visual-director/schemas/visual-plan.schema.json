{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "narrative-visual-director-plan.schema.json",
  "title": "Narrative Visual Director Plan",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "scene_summary": { "type": "string" },
    "subject_count": { "type": "integer", "minimum": 1 },
    "visible_emotion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
        "evidence": { "type": "array", "items": { "type": "string" }, "maxItems": 4 }
      },
      "required": ["label", "confidence", "evidence"]
    },
    "state": { "type": "string", "enum": ["baseline", "pressure", "crisis", "decision", "agency", "resolution"] },
    "archetype": { "type": "string", "enum": ["path_space", "boundary_emotion", "rebellion_time", "focus_attention"] },
    "primary_variable": { "type": "string" },
    "coupled_pair": { "type": "string" },
    "secondary_variables": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 3 },
    "identity_anchors": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 6 },
    "relationship_direction": { "type": ["string", "null"] },
    "camera_strategy": { "type": "string" },
    "space_strategy": { "type": "string" },
    "value_strategy": { "type": "string" },
    "color_strategy": { "type": "string" },
    "edge_strategy": { "type": "string" },
    "medium_strategy": { "type": "string" },
    "focus_hierarchy": { "type": "string" },
    "background_strategy": { "type": "string" },
    "readability_strategy": { "type": "string" },
    "anti_rules": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 6 },
    "final_prompt": { "type": "string" },
    "negative_prompt": { "type": "string" },
    "qa_targets": { "type": "array", "items": { "type": "string" }, "minItems": 4, "maxItems": 10 }
  },
  "required": [
    "scene_summary",
    "subject_count",
    "visible_emotion",
    "state",
    "archetype",
    "primary_variable",
    "coupled_pair",
    "secondary_variables",
    "identity_anchors",
    "camera_strategy",
    "space_strategy",
    "value_strategy",
    "color_strategy",
    "edge_strategy",
    "medium_strategy",
    "focus_hierarchy",
    "background_strategy",
    "readability_strategy",
    "anti_rules",
    "final_prompt",
    "negative_prompt",
    "qa_targets"
  ]
}